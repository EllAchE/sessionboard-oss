{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cicero",
  // OpenNext generates the fetch implementation; this small custom entry point preserves it and
  // adds the scheduled handler used by the hourly reminder Cron Trigger below.
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Magic links, calendar invites and embed snippets are all read outside a request — in an inbox,
  // a calendar client, or someone else's website — so a relative path is never enough and this has
  // to be the real origin. Self-hosters set APP_URL in the environment instead.
  //
  // MAIL_TRANSPORT is `auto`: whichever transport has credentials wins, and with none it is the dev
  // mailbox at /admin/mail. So turning this deployment's mail on is two operator steps and no
  // commit — verify a domain in Resend, point MAIL_FROM at it, then
  // `wrangler secret put RESEND_API_KEY` (a secret, never a var). Until then nothing is delivered
  // and every message is still readable at /admin/mail, which is what the demo has always done.
  //
  // MAIL_FROM below is Resend's shared test sender, which delivers to the Resend account owner and
  // 403s every other recipient (https://resend.com/docs/knowledge-base/403-error-resend-dev-domain).
  // It is a placeholder: with a key present the app warns loudly on the server console until it is
  // replaced with an address at a verified domain. See "Sending real email" in the README.
  //
  // DEMO_ONSCREEN_MAGIC_LINKS is what lets a visitor into the seeded demo without an inbox once
  // real mail is live (`T-7a` alongside `T-6`). It is off everywhere else, and even here it only
  // ever reveals a link for a pre-existing seeded demo identity at an IANA-reserved domain that no
  // mailbox can exist behind, holding no membership outside the demo events it does not own. Real
  // accounts are unreachable through it at any setting; `lib/demo-access.ts` states the boundary.
  "vars": {
    "APP_URL": "https://cicero.elehche.workers.dev",
    "MAIL_TRANSPORT": "auto",
    "MAIL_FROM": "Cicero <onboarding@resend.dev>",
    "DEMO_ONSCREEN_MAGIC_LINKS": "1"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Reminder jobs are idempotent and evaluate their own due times, so an hourly trigger keeps
  // delivery timely without duplicate mail. Cron expressions are evaluated in UTC by Cloudflare.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Pooled Neon connection, created with
  // `wrangler hyperdrive create cicero --connection-string=<neon-url>`.
  //
  // `localConnectionString` is what `wrangler dev` dials, so local runs never reach the
  // remote database. It points at the docker-compose Postgres; miniflare rejects a
  // connection string with no password, so every override needs one even under trust auth.
  // Override without editing this file:
  //   WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:pass@127.0.0.1:5432/cicero
  //
  // Query caching belongs on the Hyperdrive config, not on this binding, so it cannot be set here:
  //   wrangler hyperdrive update <id> --caching-disabled
  // Cicero wants it off. Hyperdrive caches read queries for 60s by default, and nearly every read
  // here immediately follows a write by the same person: an organizer adds a track, creates a
  // review round, submits a score, then looks at the list it belongs to. Served from cache those
  // writes look like they silently failed, so people do them twice.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0d0c43d957e24187a177a06a6dd7faed",
      "localConnectionString": "postgresql://cicero:cicero@127.0.0.1:5432/cicero"
    }
  ],

  // No R2 by default. Enabling it requires a payment method on the Cloudflare account, which is a
  // bad thing to demand of someone cloning an open-source project, so uploads fall back to the
  // `file_blob` table and the ISR cache is left unconfigured. To use R2 instead: enable it, create
  // the two buckets, uncomment this and the `incrementalCache` line in `open-next.config.ts`.
  // `lib/storage` prefers the binding whenever it is present, so nothing else changes.
  //
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "cicero-files" },
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cicero-inc-cache" }
  // ]
}
