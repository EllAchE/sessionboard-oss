{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cicero",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Magic links, calendar invites and embed snippets are all read outside a request — in an inbox,
  // a calendar client, or someone else's website — so a relative path is never enough and this has
  // to be the real origin. Self-hosters set APP_URL in the environment instead.
  //
  // MAIL_TRANSPORT is `log` on the demo deployment on purpose. Resend is wired up and works — the
  // key is a secret (`wrangler secret put RESEND_API_KEY`), never a var — but the only sender domain
  // available here is Resend's shared test domain, which delivers to the Resend account owner and
  // nobody else (https://resend.com/docs/knowledge-base/403-error-resend-dev-domain). Under a real
  // transport the sign-in page withholds the magic link, so anyone but that one address would be
  // told to check an inbox that never receives anything. `log` puts every message in /admin/mail
  // and the link on screen, which is the flow the product documents. Flip this to `resend` once
  // MAIL_FROM points at a domain verified in Resend.
  "vars": {
    "APP_URL": "https://cicero.lhar8771.workers.dev",
    "MAIL_TRANSPORT": "log",
    "MAIL_FROM": "Cicero <onboarding@resend.dev>"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Pooled Neon connection, created with
  // `wrangler hyperdrive create cicero --connection-string=<neon-url>`.
  //
  // `localConnectionString` is what `wrangler dev` dials, so local runs never reach the
  // remote database. It points at the docker-compose Postgres; miniflare rejects a
  // connection string with no password, so every override needs one even under trust auth.
  // Override without editing this file:
  //   WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:pass@127.0.0.1:5432/cicero
  //
  // Query caching belongs on the Hyperdrive config, not on this binding, so it cannot be set here:
  //   wrangler hyperdrive update <id> --caching-disabled
  // Cicero wants it off. Hyperdrive caches read queries for 60s by default, and nearly every read
  // here immediately follows a write by the same person: an organizer adds a track, creates a
  // review round, submits a score, then looks at the list it belongs to. Served from cache those
  // writes look like they silently failed, so people do them twice.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0d0c43d957e24187a177a06a6dd7faed",
      "localConnectionString": "postgresql://cicero:cicero@127.0.0.1:5432/cicero"
    }
  ],

  // No R2 by default. Enabling it requires a payment method on the Cloudflare account, which is a
  // bad thing to demand of someone cloning an open-source project, so uploads fall back to the
  // `file_blob` table and the ISR cache is left unconfigured. To use R2 instead: enable it, create
  // the two buckets, uncomment this and the `incrementalCache` line in `open-next.config.ts`.
  // `lib/storage` prefers the binding whenever it is present, so nothing else changes.
  //
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "cicero-files" },
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cicero-inc-cache" }
  // ]
}
