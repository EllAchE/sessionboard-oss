{
  "name": "cicero",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "bun audit --audit-level=high",
    "bench": "tsx scripts/benchmark.ts",
    "alternatives:build": "tsx scripts/alternatives/build.ts",
    "alternatives:check": "tsx scripts/alternatives/build.ts --check",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx scripts/eval-loop.ts",
    "eval:loop": "tsx scripts/eval-loop.ts --loop",
    "eval:archive": "tsx scripts/archive-sessionboard-eval.ts",
    "verify:headshots": "tsx scripts/verify-speaker-headshots.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "db:migrate:remote": "MIGRATE_REQUIRE_REMOTE=1 tsx db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed.ts",
    "db:seed:first-settlement": "tsx --env-file-if-exists=.env db/seed-first-settlement.ts",
    "docs:openapi": "tsx scripts/generate-openapi.ts",
    "docs:mcp": "tsx scripts/generate-mcp-tools.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "bun run db:migrate:remote && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@opennextjs/cloudflare": "^1.0.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "^0.45.2",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.0",
    "next": "^15.1.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@fontsource/archivo": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.2"
  }
}
