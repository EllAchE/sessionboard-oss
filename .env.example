# Copy to `.env` for local development. Nothing here is required by `docker compose up` —
# that path sets its own values in docker-compose.yml.
#
# On Cloudflare, the values below are set with `wrangler secret put <NAME>` (or as `vars` in
# wrangler.jsonc when they are not secret). DATABASE_URL is the exception: on Workers the
# connection string comes from the Hyperdrive binding and this variable is ignored.

# --- Core -------------------------------------------------------------------

# Absolute origin, used to build magic links, embed snippets and calendar invites.
APP_URL=http://localhost:3000

# Self-host / local only. Ignored on Workers, where HYPERDRIVE supplies the connection.
DATABASE_URL=postgresql://cicero:cicero@localhost:5434/cicero

# `pg` pool size. Keep small on Workers; Hyperdrive is already pooling in front of it.
DATABASE_POOL_MAX=5

# --- File storage (S3 API: R2 on Cloudflare, MinIO self-hosted) --------------

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cicero-files
S3_ACCESS_KEY_ID=cicero
S3_SECRET_ACCESS_KEY=cicero-secret
# MinIO needs path-style addressing; R2 does not.
S3_FORCE_PATH_STYLE=true

# --- Email ------------------------------------------------------------------

# `resend` | `smtp` | `log`. Every transport also writes to email_log, so `log` is a
# complete dev mailbox at /admin/mail rather than a stub. Workers cannot open SMTP sockets.
#
# Naming a transport whose settings below are blank falls back to `log` and warns on the
# server console — mail is still recorded and readable at /admin/mail, but nothing is sent.
MAIL_TRANSPORT=log
# Has to be an address at a domain the provider has verified, or real sends are rejected.
MAIL_FROM=cicero@localhost

# MAIL_TRANSPORT=resend
RESEND_API_KEY=

# MAIL_TRANSPORT=smtp — self-host only; Workers has no raw TCP for SMTP.
# Either set SMTP_URL, or leave it blank and fill in the discrete fields underneath it.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS on connect, i.e. port 465. STARTTLS on 587 is negotiated anyway and is not this.
SMTP_SECURE=false
# Accept a self-signed certificate. For MailHog and other local catchers, not for production.
SMTP_ALLOW_INSECURE=false

# --- SMS --------------------------------------------------------------------

# `twilio` | `log`. Every transport also writes to sms_log, so `log` is a complete dev
# mailbox at /admin/sms rather than a stub.
SMS_TRANSPORT=log
SMS_FROM=

# SMS_TRANSPORT=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- AI (V-9 review assist, A-8 agenda builder) -----------------------------

# Unset disables both features rather than failing a request.
ANTHROPIC_API_KEY=

# --- Accelevents (N-1) ------------------------------------------------------

ACCELEVENTS_API_KEY=
ACCELEVENTS_BASE_URL=https://api.accelevents.com
ACCELEVENTS_EVENT_URL=
# The docs disagree with themselves on the header name; the client retries once with `Key`
# on a 401. See docs/reference/accelevents-api.md.
ACCELEVENTS_AUTH_HEADER=Authorization

# --- Airtable one-way mirror (Z-2) ------------------------------------------

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
