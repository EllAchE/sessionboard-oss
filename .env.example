# Copy to `.env` for local development. Nothing here is required by `docker compose up` —
# that path sets its own values in docker-compose.yml.
#
# On Vercel, set deployment values with `vercel env add`. On Cloudflare, runtime values below use
# `wrangler secret put <NAME>` (or `vars` in wrangler.jsonc when they are not secret).
# `DATABASE_URL` is still required on the machine that
# runs `bun run cf:deploy`, because migrations run before the Worker deploys; the Worker itself uses
# the Hyperdrive binding.

# --- Core -------------------------------------------------------------------

# Absolute origin, used to build magic links, embed snippets and calendar invites.
APP_URL=http://localhost:3000

# Self-host / local only. Ignored on Workers, where HYPERDRIVE supplies the connection.
DATABASE_URL=postgresql://cicero:cicero@localhost:5434/cicero

# `pg` pool size. Keep small on Workers; Hyperdrive is already pooling in front of it.
DATABASE_POOL_MAX=5

# Protects the public cron endpoint. Cloudflare's in-process schedule also sends it when configured.
# Use a long random value for every deployment exposed to the internet.
CRON_SECRET=

# Turns a deployment into a public sandbox. Email and SMS always use their log transports,
# even when provider credentials are present. Sign-in links appear on-screen for any address,
# so email ownership is not verified. Never enable this for a real event.
CICERO_PUBLIC_TEST_MODE=false

# --- File storage (S3 API: R2 on Cloudflare, MinIO self-hosted) --------------

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cicero-files
S3_ACCESS_KEY_ID=cicero
S3_SECRET_ACCESS_KEY=cicero-secret
# MinIO needs path-style addressing; R2 does not.
S3_FORCE_PATH_STYLE=true

# --- Email ------------------------------------------------------------------

# `resend` | `smtp` | `log` | `auto`. Every transport also writes to email_log, so `log` is
# a complete dev mailbox at /organizer/mail rather than a stub. Workers cannot open SMTP sockets.
#
# Naming a transport whose settings below are blank falls back to `log` and warns on the
# server console — mail is still recorded and readable at /organizer/mail, but nothing is sent.
#
# `auto` takes whichever transport has credentials and is quiet when that is none, so an
# instance can be switched on by adding a key rather than by editing configuration. It is
# what the deployed demo uses.
MAIL_TRANSPORT=log
# Has to be an address at a domain the provider has verified, or real sends are rejected.
MAIL_FROM=cicero@localhost

# MAIL_TRANSPORT=resend
RESEND_API_KEY=

# MAIL_TRANSPORT=smtp — self-host only; Workers has no raw TCP for SMTP.
# Either set SMTP_URL, or leave it blank and fill in the discrete fields underneath it.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS on connect, i.e. port 465. STARTTLS on 587 is negotiated anyway and is not this.
SMTP_SECURE=false
# Accept a self-signed certificate. For MailHog and other local catchers, not for production.
SMTP_ALLOW_INSECURE=false

# Addresses at IANA-reserved domains (example.com, *.example, .test, .invalid, .localhost) are
# always handled by the log transport whatever is set above: nothing can be delivered to them,
# and a real provider would bounce the seeded demo's six hundred fictional speakers and spend
# the sender's reputation doing it. Real recipients in the same run still get real mail.

# --- Public demo access (T-7a) ----------------------------------------------

# Off unless set. On, and only under a real transport, the sign-in page will show the magic
# link on screen for a seeded demo identity — an existing account, at one of those reserved
# domains, with no membership on any event outside the demo it does not itself own. Real
# accounts can never be reached this way. Leave it off unless this instance is a public demo
# carrying seed data; see lib/demo-access.ts for the threat model.
DEMO_ONSCREEN_MAGIC_LINKS=false
# Which events count as the demo, and the address the sign-in page offers as the way in.
DEMO_EVENT_SLUGS=demo,first-settlement
DEMO_SIGNIN_EMAIL=organizer@example.com

# --- SMS --------------------------------------------------------------------

# `twilio` | `log`. Every transport also writes to sms_log, so `log` is a complete dev
# mailbox at /organizer/sms rather than a stub.
SMS_TRANSPORT=log
SMS_FROM=
# National-format numbers use this ISO country before being stored as E.164.
SMS_DEFAULT_COUNTRY=US

# SMS_TRANSPORT=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Live SMS remains on the log transport unless APP_URL is a public HTTPS origin.
# Configure the Twilio number/Messaging Service inbound webhook as:
#   https://your-cicero.example/api/webhooks/twilio/sms
# Outbound sends attach /api/webhooks/twilio/status automatically.

# --- AI (V-9 review assist, A-8 agenda builder) -----------------------------

# Unset disables both features rather than failing a request.
ANTHROPIC_API_KEY=

# --- Accelevents (N-1) ------------------------------------------------------

ACCELEVENTS_API_KEY=
ACCELEVENTS_BASE_URL=https://api.accelevents.com
ACCELEVENTS_EVENT_URL=
# The docs disagree with themselves on the header name; the client retries once with `Key`
# on a 401. See docs/reference/accelevents-api.md.
ACCELEVENTS_AUTH_HEADER=Authorization
# Deterministic demo adapter. Never enable this in an environment used for real Accelevents data.
ACCELEVENTS_FAKE=false

# --- Airtable one-way mirror (Z-2) ------------------------------------------

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Optional overrides; the defaults are Submissions, Speakers, and Sessions.
AIRTABLE_TABLE_SUBMISSIONS=
AIRTABLE_TABLE_SPEAKERS=
AIRTABLE_TABLE_SESSIONS=
