# Local overrides for the miniflare Cloudflare context that `next dev` runs against. Wrangler reads
# this file only in development and never at deploy, so it is checked in rather than kept per-machine.
#
# APP_URL is here because `wrangler.jsonc` has to name the deployed origin, and that value reaches
# the dev server too. A magic link built from it points at production, where the token a developer
# just created does not exist — sign-in on localhost dead-ends at ?error=expired. This puts the
# origin back on localhost so a locally created token is redeemed by the local app.
APP_URL=http://localhost:3000
